# Secrets for the LOCAL SaaS test stack (docker-compose.saas-dev.yml).
# Copy to .env.saas-dev.local (gitignored via `.env*.local`) and fill in.
#
#   cp .env.saas-dev.example .env.saas-dev.local
#
# These are throwaway, localhost-only values. Do NOT reuse the ones from your real .env:
# a separate AUTH_SECRET is what keeps the two stacks' sessions from crossing over.

# Signs the SaaS account session cookie. Min 16 chars.
#   openssl rand -base64 32
AUTH_SECRET=

# Keeps Server Action ids stable across rebuilds. Must be base64 of 32 bytes.
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Emails allowed into the cross-tenant superadmin console at /admin. Comma separated.
# Empty ⇒ /admin is a 404 for everyone.
SAAS_SUPERADMIN_EMAILS=

# ─ Optional, all unset by default ─────────────────────────────────────────────
# Email: with none of these set the mailer prints the message to the container log
# instead of sending, which is what you want locally (`docker logs pharos-saas-web`).
# RESEND_API_KEY=
# MAIL_WEBHOOK_URL=
# MAIL_FROM=Pharos <no-reply@ph-aros.com>
#
# Stripe: billing pages render without these; checkout stays inert.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SHARED=
# STRIPE_PRICE_DEDICATED=
#
# Bearer token for the scheduler endpoints, all three of which live under /api/cron/saas/
# (that prefix is the one excluded from the session gate in middleware.ts):
#
#   POST /api/cron/saas/usage-sample    per-tenant storage sampling → Usage ledger
#   POST /api/cron/saas/trials-sweep    trial warnings + lapse suspensions
#   POST /api/cron/saas/erasure-purge   GDPR Art. 17 purge scan (report-only, never drops)
#
# Unset ⇒ all three answer 500 "CRON_SECRET is not configured": they fail CLOSED, so a
# half-configured deployment cannot be swept by anyone who simply omits the header.
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" http://lvh.me:3001/api/cron/saas/trials-sweep
# CRON_SECRET=

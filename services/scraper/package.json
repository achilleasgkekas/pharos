{
  "name": "homepage-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Price tracking worker: fetches product pages, extracts prices via local Ollama, writes priceHistory, alerts on drops via ntfy.",
  "scripts": {
    "scrape:once": "tsx src/once.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mongoose": "^8.24.4",
    "node-cron": "^4.6.0",
    "ollama": "^0.6.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}

{
  "name": "homepage-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Price tracking worker: fetches product pages, extracts prices via local Ollama, writes priceHistory, alerts on drops via ntfy.",
  "scripts": {
    "scrape:once": "tsx src/once.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mongoose": "^8.8.0",
    "node-cron": "^4.2.1",
    "ollama": "^0.5.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

{
  "manifest_version": 3,
  "name": "Pharos quick capture",
  "version": "1.0.0",
  "description": "Send the page you are on to your own Pharos instance, straight into the shopping list or inventory.",
  "homepage_url": "https://github.com/AchilleasGekas/pharos",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Add this page to Pharos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}

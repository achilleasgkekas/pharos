{
  "expo": {
    "name": "Pharos",
    "slug": "pharos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.achilleas.pharos"
    },
    "android": {
      "package": "com.achilleas.pharos",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-image-picker", { "cameraPermission": "Pharos uses the camera to scan products for your shopping list." }],
      ["expo-camera", { "cameraPermission": "Pharos uses the camera to read product barcodes while the scanner is open." }],
      ["expo-notifications", { "color": "#00ff88" }]
    ]
  }
}

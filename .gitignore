venv/
.vite/
lint_*.json
lint_*.txt
eslint_report.json

# data exports
tracker-export.json

# email import (Gmail Takeout MBOX — personal, never commit)
.email-import/

# personal working docs + setup notes (kept locally, never uploaded)
# CLAUDE.md / AGENTS.md are the AI agents' shared context: internal hostnames, IPs and the
# deploy layout. They must stay local — this repo is heading to AGPL open-source.
CLAUDE.md
AGENTS.md
BACKLOG.md
PLANNING.md
10G_Products_List_v3.md
10G_Products_List_v2.md
network_dashboard.html
research/
scripts/seed-10g.js
scripts/seed-10g-v3.js
services/scraper/_audit.ts
.claude/settings.local.json
.claude/settings.json

# What the running containers were built from. Server-side state, never the repo.
deploy/.deployed

# fail2ban bridge runtime queues (deploy/f2b/): request/done/rejected dirs + state.json,
# operational data written by a live process on the server, not source code — same idea as
# deploy/backups/ and deploy/storage/ above. The bridge SCRIPT itself (deploy/f2b-bridge.sh) is
# real infrastructure code and stays tracked; only this runtime state is ignored, so nothing
# here ever risks capturing live ban-queue data into git history.
deploy/f2b/


# ─── MongoDB ───────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=changeme

# ─── Mongo Express UI (port 8081) ──────────────────────────────────────────
ME_USER=admin
ME_PASS=changeme

# ─── App-level (used by docker-compose web service) ────────────────────────
# Inside the Docker network, Mongo is reachable as host "mongo".
# Ollama runs NATIVE on the Mac host (Apple Neural Engine), reachable from
# the container via host.docker.internal.
OLLAMA_MODEL=qwen2.5vl:7b
# LLM context window. Default 8192. Larger fits bigger pages but uses more RAM.
# The small Ollama default truncates large pages and breaks JSON parsing.
OLLAMA_NUM_CTX=8192

# ─── FlareSolverr (Cloudflare bypass for Skroutz etc.) ─────────────────────
# Headless-Chromium proxy. In compose, services reach it as http://flaresolverr:8191
# (this default). A NATIVE `npm run dev` web server must instead set, in
# apps/web/.env.local: SOLVER_URL=http://localhost:8191
SOLVER_URL=http://flaresolverr:8191

# ─── Price scraper (opt-in: docker compose --profile scraper up -d) ────────
SCRAPER_CRON=0 */6 * * *
PRICE_DROP_ALERT_PCT=10
# ntfy push alerts on price drops. Leave NTFY_TOPIC empty to disable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

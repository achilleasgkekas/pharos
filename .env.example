# ─── MongoDB ───────────────────────────────────────────────────────────────
# CHANGE THESE. Generate a strong password, e.g.: openssl rand -base64 24
# The password is baked into the data volume on FIRST init only; rotating it
# later also requires db.changeUserPassword on the running container.
MONGO_USER=admin
MONGO_PASS=change-me-openssl-rand-base64-24
# Full connection string the app reads. Inside compose it is derived from the
# two vars above and the "mongo" service host, so you rarely set it by hand.
# For a NATIVE `npm run dev` web server (no compose) set it in apps/web/.env.local:
#   MONGO_URI=mongodb://admin:yourpass@localhost:27017/homepage?authSource=admin
MONGO_URI=mongodb://admin:change-me@mongo:27017/homepage?authSource=admin

# ─── Mongo Express UI (port 8081) ──────────────────────────────────────────
ME_USER=admin
ME_PASS=change-me-openssl-rand-base64-24

# ─── Server Actions encryption key (REQUIRED) ──────────────────────────────
# Stable key so Server Action IDs survive rebuilds. Secret — generate with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ─── Login / session (REQUIRED) ────────────────────────────────────────────
# Signs the session cookie. Secret — generate with: openssl rand -base64 32
# If unset, the app fails closed (nobody can log in). Rotating it logs everyone out.
AUTH_SECRET=change-me-openssl-rand-base64-32
# Set to "true" ONLY when the app is served over HTTPS (TLS reverse proxy). On a
# plain-HTTP LAN/WireGuard deployment leave it false or the login cookie won't set.
AUTH_COOKIE_SECURE=false
# How long a session stays valid WITHOUT activity (hours). Slid forward on each
# request, so active use stays signed in; idle past this logs out. Default 12.
SESSION_IDLE_HOURS=12

# ─── /api/v1 rate limiting (OPTIONAL — off by default) ─────────────────────
# Blunt runaway clients and login brute-force on a shared/public deployment.
# Counted per API token (authenticated routes) and per client IP (login). Over
# the limit → HTTP 429 + Retry-After. Leave blank/0 to disable (single-user
# self-host does not need it). Example: 120 requests per 60s window.
API_RATE_LIMIT=
API_RATE_WINDOW_MS=60000

# ─── App-level (used by docker-compose web service) ────────────────────────
# Inside the Docker network, Mongo is reachable as host "mongo".
# Ollama runs NATIVE on the Mac host (Apple Neural Engine), reachable from
# the container via host.docker.internal.
# Where the app reads/writes binary files (receipt images, statement PDFs).
# In compose this is a mounted volume at /storage; native dev defaults to ./storage.
STORAGE_ROOT=/storage
# Base URL of the Ollama server. Compose points it at the Mac host gateway;
# a native dev server on the same machine uses http://localhost:11434.
OLLAMA_HOST=http://host.docker.internal:11434
# Text/vision model for receipts, statements, product parsing (the "active" model).
OLLAMA_MODEL=qwen2.5vl:7b
# Separate model used for image (vision) parsing when the active model is text-only.
# Defaults to qwen2.5vl:7b; leave unset to auto-pick.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# How long Ollama keeps a model warm in RAM after a request. Default 30m.
OLLAMA_KEEP_ALIVE=30m
# LLM context window. Default 8192. Larger fits bigger pages but uses more RAM.
# The small Ollama default truncates large pages and breaks JSON parsing.
OLLAMA_NUM_CTX=8192
# SearXNG metasearch instance for "AI fill from web" and product-photo lookup.
# In compose it is http://searxng:8080; native dev defaults to http://localhost:8888.
SEARXNG_URL=http://searxng:8080

# ─── Cloud AI providers (OPTIONAL) ─────────────────────────────────────────
# All AI is local (Ollama) by default. Set a key here ONLY if you switch a
# provider in Settings → AI engine to a hosted model. These keys can also be
# stored in the DB via Settings; the env var is just a fallback. Leave blank to
# keep everything local (no data leaves your machine).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Exchange rates (multi-currency only, P9) ──────────────────────────────
# The "Market rate" button looks up ECB reference rates from a Frankfurter
# instance (no API key, no account). Leave empty for the public one; point it at
# your own instance to keep the lookup on your network. Nothing is fetched while
# multi-currency is off, and a fetched rate is never applied without you saving it.
# FX_RATE_API_URL=https://api.frankfurter.dev/v1

# ─── FlareSolverr (Cloudflare bypass for Skroutz etc.) ─────────────────────
# Headless-Chromium proxy. In compose, services reach it as http://flaresolverr:8191
# (this default). A NATIVE `npm run dev` web server must instead set, in
# apps/web/.env.local: SOLVER_URL=http://localhost:8191
SOLVER_URL=http://flaresolverr:8191

# ─── Price scraper (opt-in: docker compose --profile scraper up -d) ────────
SCRAPER_CRON=0 */6 * * *
PRICE_DROP_ALERT_PCT=10
# ntfy push alerts on price drops. Leave NTFY_TOPIC empty to disable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Public URL of your own instance, used by integrations.
APP_URL=
# Scheduler authentication. Generate with: openssl rand -base64 32
CRON_SECRET=
# ─ Error reporting (optional) ─
# Sentry DSN. Unset ⇒ no error reporting and the SDK is never loaded. Read at runtime, not baked
# into the build. Only errors are sent (no tracing/replay); cookies, bodies, query strings, IPs
# and emails are scrubbed first (lib/errorReporting.ts).
SENTRY_DSN=
# Optional label; defaults to "self-hosted".
SENTRY_ENVIRONMENT=

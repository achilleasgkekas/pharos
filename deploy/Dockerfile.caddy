# Caddy with the Cloudflare DNS plugin.
#
# The stock caddy image cannot solve the ACME DNS-01 challenge, and DNS-01 is not optional here:
# tenant workspaces live on `<slug>.ph-aros.com`, so the certificate has to be a WILDCARD, and
# Let's Encrypt only issues wildcards over DNS-01. HTTP-01 would force a certificate request per
# workspace, i.e. a new cert every signup and a hard rate-limit wall.
#
# Pinned to a Caddy 2 minor rather than :latest so a rebuild on the server cannot quietly change
# the proxy in front of everything.
FROM caddy:2.10-builder AS builder
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2.10
COPY --from=builder /usr/bin/caddy /usr/bin/caddy

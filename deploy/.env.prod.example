# Copy to deploy/.env.prod on the SERVER and fill in. Never commit the filled version.
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
#
# Generate every secret below with `openssl rand -base64 32`. Do not reuse anything from your
# home instance: a secret that exists in two places is a secret that leaks from the weaker one.

# ── domain ────────────────────────────────────────────────────────────────────
SAAS_BASE_DOMAIN=ph-aros.com
ACME_EMAIL=you@example.com
# Cloudflare token with EXACTLY Zone:Read + DNS:Edit, scoped to this one zone. Not the Global
# API Key: that one can do anything to every zone on the account, and it would live in this file
# on an internet-facing machine.
CF_API_TOKEN=

# ── database ──────────────────────────────────────────────────────────────────
MONGO_USER=pharos
MONGO_PASSWORD=

# ── app secrets ───────────────────────────────────────────────────────────────
# Signs the account session cookie. Changing it signs everyone out.
AUTH_SECRET=
# Keeps Server Action ids stable across rebuilds. Without a FIXED value, every deploy invalidates
# the actions in browser tabs that are already open and users get an error on their next click.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Bearer token for the scheduler endpoints under /api/cron/saas/*. Unset means those endpoints
# fail closed (500), so the usage sampler and trial sweep silently never run.
CRON_SECRET=

# ── abuse limits (REQUIRED in production) ─────────────────────────────────────
# The rate limiter is OFF unless this is set, so leaving it blank silently disables the guards on
# login, signup, password-reset request and reset-confirm — the four endpoints an anonymous
# stranger can reach. A self-hosted single user never trips it; a public deployment needs it.
# Per client IP, per window, per endpoint (each endpoint has its own bucket).
API_RATE_LIMIT=30
API_RATE_WINDOW_MS=60000

# The activation endpoint (the ONE door to a paid plan) does not use the budget above: 30/min is
# far too much rope for a code like FRIENDS-2026. It defaults to 5 attempts per hour per IP and
# per account, and unlike the limiter above it is ON even if you leave these blank. Set them only
# to tighten further; an explicit 0 turns the guard off.
SAAS_ACTIVATE_RATE_LIMIT=
SAAS_ACTIVATE_RATE_WINDOW_MS=

# ── operator console ──────────────────────────────────────────────────────────
# Emails allowed into /admin. Empty ⇒ /admin is a 404 for everyone, including you.
SAAS_SUPERADMIN_EMAILS=

# ── email (REQUIRED before real customers) ────────────────────────────────────
# With none of these set the mailer logs instead of sending, so verification links, invites and
# dunning emails reach nobody. Precedence: RESEND_API_KEY > MAIL_WEBHOOK_URL > SMTP_URL.
#
# GMAIL over SMTP (what this deployment uses). The password is a Google APP PASSWORD, not the
# account password: it needs 2-Step Verification on the account, and you strip the spaces Google
# displays it with.
#
# Separate fields, NOT an SMTP_URL. The username is an email address and therefore contains an
# '@', which inside a URL gives you two of them and makes the parser split on the wrong one. That
# surfaces as an authentication failure, so you go looking for a wrong password instead of a
# wrong URL. Separate fields cannot be encoded wrong.
#
# The connection verifies the server certificate and requires TLS 1.2 or better. That is not
# optional here: password-reset links travel this path, so anyone able to sit in the middle would
# get both the credentials and the contents.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=achilleas.gkekas@gmail.com
# Paste the app password with the DISPLAYED SPACES REMOVED. Google shows it as four groups of
# four; keeping the spaces gives you 19 characters instead of 16 and Gmail simply rejects it.
SMTP_PASS=
#
# MAIL_FROM must carry the SAME mailbox that authenticates above. Gmail rewrites the From header
# to the authenticated account unless the address is a verified "send mail as" alias, so setting
# no-reply@ph-aros.com here would silently show the recipient a different sender than intended.
# The display name is free, only the address is constrained.
# QUOTED: the value contains < >, which a shell reads as redirects. deploy/backup.sh sources
# this file, so an unquoted MAIL_FROM makes the BACKUP fail with a syntax error, nowhere near
# where you would look for it.
MAIL_FROM="Pharos <achilleas.gkekas@gmail.com>"
#
# Ceiling is roughly 500 messages a day on a free Gmail account. That is a beta-sized limit; a
# real customer base needs a proper sending domain (Resend / SES / Postmark) with SPF+DKIM, both
# for volume and so the mail is not filed as spam.
# RESEND_API_KEY=

# ── billing (REQUIRED before charging anyone) ─────────────────────────────────
# Without these the billing pages render but checkout stays inert. Nobody can pay you.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SHARED=
# STRIPE_PRICE_DEDICATED=

# ── backups ───────────────────────────────────────────────────────────────────
# Offsite target for deploy/backup.sh, as an rclone remote path. A backup that lives on the same
# disk as the data is not a backup: it dies with the machine it was protecting.
# Two ways, use one. BACKUP_SSH is rsync over SSH and needs nothing installed, which is why it is
# the one wired up here for the Hetzner Storage Box (port 23, key auth). BACKUP_REMOTE is an
# rclone remote if you prefer that.
BACKUP_SSH=u645343@u645343.your-storagebox.de:pharos
BACKUP_SSH_PORT=23
BACKUP_SSH_KEY=/root/.ssh/storagebox
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=14
